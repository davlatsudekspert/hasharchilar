<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+): zaxira va qurilmadan-qurilmaga ko'chirishda ilova ma'lumotlari OLINMAYDI.
  WebView localStorage'dagi sessiya tokeni (hashar_token, 90 kun) boshqa qurilmaga o'tib qolmasin.
  Android 11 va pastda android:allowBackup="false" yetarli.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
